# === Kopieer naar .env en pas aan (of gebruik deploy/install.sh) ===

# --- Build & GPU (gelezen door docker compose) ---
# NeMo/Canary meebouwen in de worker-image (1) of niet (0).
INSTALL_NEMO=1
# torch-build: "default" voor nieuwe GPU's (RTX Pro 6000/sm_120, Hopper, Ada,
# Ampere, Turing) of "cu124" voor Tesla V100 (Volta/sm_70).
TORCH_VARIANT=default
# CDI-device voor de worker: "nvidia.com/gpu=all", of een index "nvidia.com/gpu=0".
WORKER_GPU_DEVICE=nvidia.com/gpu=all

# --- Web / HTTPS ---
SITE_ADDRESS=localhost
# "internal" = Caddy lokale CA (dev). Voor prod: e-mailadres voor Let's Encrypt.
CADDY_TLS=internal
# Certificaat voor SNI-loze verbindingen (toegang via IP-adres). Zet op je hoofd-hostnaam.
DEFAULT_SNI=localhost
# Publiceer-poorten (verhoog als er al een reverse-proxy op 80/443 draait).
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443


# --- Infrastructuur ---
DATABASE_URL=postgresql+asyncpg://transcribe:transcribe@db:5432/transcribe
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data

# --- Uploadlimieten ---
MAX_UPLOAD_MB=200
DEFAULT_LANGUAGE=nl
# ASR-audio-optimalisatie (hoogdoorlaat + loudness-normalisatie) standaard aan.
AUDIO_OPTIMIZE_DEFAULT=true

# --- Bewaartermijn (werkdagen ná verwerking; weekenden tellen niet mee) ---
RETENTION_WORKDAYS=2
CLEANUP_INTERVAL_SECONDS=3600

# --- STT (spraak-naar-tekst) ---
# STT_BACKEND: "faster_whisper" (default) | "canary" (NeMo) | "openai" (extern endpoint).
STT_BACKEND=faster_whisper
# faster_whisper: large-v2 (NIET large-v3). canary: nvidia/canary-1b-v2.
# openai: de modelnaam die je STT-endpoint verwacht (bv. whisper-1).
STT_MODEL=large-v2
# STT_DEVICE: "cuda" (GPU) of "cpu". STT_COMPUTE_TYPE:
#   faster_whisper: int8 (cpu) | float16 (gpu) | int8_float16 | float32
#   canary:         float32 (cpu) | float16 (gpu)
# LET OP: op oudere GPU's (Tesla V100/Volta, sm_70) is TORCH_VARIANT=cu124 nodig.
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# Begrens gelijktijdige STT-jobs zodat piek-VRAM voorspelbaar blijft (bij gedeelde GPU).
STT_CONCURRENCY=1
# Woord/segment-timestamps. LET OP (canary): true laadt een intern timestamps-model
# (~2-3GB fp32 extra VRAM). Op een krappe/gedeelde GPU zonder marge: zet false, dan
# past Canary (alleen hoofdmodel, ~2GB fp16) wél op de GPU — zonder timestamps.
STT_WORD_TIMESTAMPS=true

# --- STT via extern OpenAI-compatibel endpoint (alleen bij STT_BACKEND=openai) ---
# Bv. whisper.cpp-server of een faster-whisper OpenAI-wrapper. De worker heeft dan
# geen STT-model/torch/GPU nodig; zet dan ook INSTALL_NEMO=0 en STT_DEVICE=cpu.
STT_OPENAI_BASE_URL=http://host.docker.internal:8035/v1
STT_OPENAI_API_KEY=not-needed
STT_OPENAI_TIMEOUT_SECONDS=600

# --- Verslag-LLM: bestaand OpenAI-compatibel endpoint (er wordt geen LLM gehost) ---
# Draait de LLM op dezelfde host als Docker? Gebruik http://host.docker.internal:PORT/v1.
# Op een andere host: gebruik dat IP/DNS. `.local` (mDNS) werkt vaak NIET in containers.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=600

# Pad naar PROMPTS.md in de container (wordt via compose gemount).
PROMPTS_FILE=/app/PROMPTS.md
