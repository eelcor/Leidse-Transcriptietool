# Worker-image: STT (ffmpeg + faster-whisper, optioneel NeMo/Canary) + LLM-client.
#
# GPU: draai met de NVIDIA Container Toolkit. Voor Canary op GPU heb je een CUDA-
# passende torch + nemo_toolkit nodig; zet dan INSTALL_NEMO=1 (en pas de base
# image eventueel aan naar een CUDA-image). Default draait faster-whisper, wat
# ook op CPU werkt (STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8).
FROM python:3.11-slim

ARG INSTALL_NEMO=0
# TORCH_VARIANT bepaalt welke torch-build NeMo gebruikt:
#   "default" -> torch van PyPI (CUDA 13): voor nieuwe GPU's zoals de RTX Pro 6000
#                (Blackwell/sm_120), Hopper (sm_90), Ada (sm_89), Ampere, Turing (sm_75).
#   "cu124"   -> torch 2.6.0+cu124: nodig voor Tesla V100 (Volta/sm_70), want
#                CUDA 13 laat Volta vallen ("no kernel image available").
# install.sh detecteert de GPU en zet dit automatisch juist.
ARG TORCH_VARIANT=default

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ffmpeg voor resampling naar 16kHz mono.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt
# Canary/NeMo optioneel. Voor Tesla V100 (Volta/sm_70): expliciet torch met
# CUDA 12.x (cu13 laat sm_70 vallen). We installeren die eerst en pinnen torch
# via een constraint, zodat NeMo torch niet upgradet naar een cu13-build.
# Op een nieuwe GPU (RTX Pro 6000 = sm_120) mag je de cu124-regel weglaten en
# gewoon `pip install "nemo_toolkit[asr]==2.7.3" torch` gebruiken.
# Aparte layers zodat een geslaagde (grote) torch-download gecached blijft en een
# retry na een netwerkhapering alleen NeMo opnieuw hoeft te halen.
# Stap 1: torch installeren volgens TORCH_VARIANT.
RUN if [ "$INSTALL_NEMO" = "1" ]; then \
        if [ "$TORCH_VARIANT" = "cu124" ]; then \
            pip install --no-cache-dir --timeout 600 --retries 10 torch==2.6.0+cu124 \
                --index-url https://download.pytorch.org/whl/cu124 ; \
        else \
            pip install --no-cache-dir --timeout 600 --retries 10 torch ; \
        fi ; \
    fi
# Stap 2: NeMo installeren, met torch gepind op de zojuist geïnstalleerde versie
# zodat NeMo torch niet upgradet naar een build die jouw GPU niet ondersteunt.
RUN if [ "$INSTALL_NEMO" = "1" ]; then \
        echo "torch==$(python -c 'import torch; print(torch.__version__.split(\"+\")[0])')" > /tmp/torch-constraint.txt && \
        pip install --no-cache-dir --timeout 600 --retries 10 \
            -c /tmp/torch-constraint.txt "nemo_toolkit[asr]==2.7.3" ; \
    fi

COPY app ./app
COPY worker ./worker

# arq-worker; verwerkt STT- en LLM-jobs.
CMD ["arq", "worker.worker.WorkerSettings"]
