# Worker-image: STT (ffmpeg + faster-whisper) + LLM-client.
#
# Default-build is LICHT en betrouwbaar: faster-whisper (CTranslate2), zonder torch
# of NeMo. Voor GPU (STT_DEVICE=cuda) leveren we alleen de CUDA-libs die CTranslate2
# nodig heeft (cuBLAS + cuDNN + CUDA-runtime) via pip; CTranslate2 4.x vindt die
# automatisch in site-packages (geen LD_LIBRARY_PATH nodig).
#
# Optioneel: NVIDIA Canary via NeMo (STT_BACKEND=canary) -> zet INSTALL_NEMO=1.
# NeMo is zwaar en torch/CUDA-gevoelig; bewust opt-in en losgekoppeld van de
# standaard-build. (Diarisatie/pyannote komt later, zie ROADMAP.md.)
FROM python:3.11-slim

# GPU-libs voor faster-whisper/CTranslate2. Zet STT_GPU=0 voor een CPU-only image
# (bespaart ~0,5 GB; draai dan met STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8).
ARG STT_GPU=1
# Optionele Canary/NeMo-backend (zwaar). Default UIT.
ARG INSTALL_NEMO=0
# torch-build voor NeMo: "default" (nieuwe GPU's) of "cu124" (Tesla V100/Volta).
ARG TORCH_VARIANT=default

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ffmpeg voor resampling naar 16kHz mono.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# GPU-libs voor CTranslate2 (faster-whisper) EERST, in een eigen layer, zodat een
# geslaagde (grote) cuDNN-download gecached blijft en latere requirement-wijzigingen
# 'm niet opnieuw triggeren. CTranslate2 4.x laadt cuBLAS/cuDNN automatisch uit de
# nvidia-*-cu12 pip-pakketten. Versies gepind op een met CTranslate2 4.8 geteste
# combinatie (cuDNN 9, CUDA 12.4).
RUN if [ "$STT_GPU" = "1" ]; then \
        pip install --no-cache-dir --timeout 600 --retries 10 \
            nvidia-cublas-cu12==12.4.5.8 \
            nvidia-cudnn-cu12==9.1.0.70 \
            nvidia-cuda-runtime-cu12==12.4.127 ; \
    fi

# App-requirements (basis + faster-whisper). Na de GPU-libs zodat een wijziging hier
# de cuDNN-layer niet invalideert.
COPY requirements.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

# --- Optioneel: Canary via NeMo (opt-in, losgekoppeld van de default-build) ---
# Stap 1: torch volgens TORCH_VARIANT (aparte layer -> cache-vriendelijk).
RUN if [ "$INSTALL_NEMO" = "1" ]; then \
        if [ "$TORCH_VARIANT" = "cu124" ]; then \
            pip install --no-cache-dir --timeout 600 --retries 10 torch==2.6.0+cu124 \
                --index-url https://download.pytorch.org/whl/cu124 ; \
        else \
            pip install --no-cache-dir --timeout 600 --retries 10 torch ; \
        fi ; \
    fi
# Stap 2: NeMo, met torch gepind zodat NeMo torch niet upgradet naar een build die
# jouw GPU niet ondersteunt.
RUN if [ "$INSTALL_NEMO" = "1" ]; then \
        echo "torch==$(python -c 'import torch; print(torch.__version__.split(\"+\")[0])')" > /tmp/torch-constraint.txt && \
        pip install --no-cache-dir --timeout 600 --retries 10 \
            -c /tmp/torch-constraint.txt "nemo_toolkit[asr]==2.7.3" ; \
    fi

COPY app ./app
COPY worker ./worker

# arq-worker; verwerkt STT- en LLM-jobs.
CMD ["arq", "worker.worker.WorkerSettings"]
