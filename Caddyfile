# Caddy: serveert de statische frontend en proxyt de API, met HTTPS.
#
# Domein en TLS-modus komen uit env-vars (gezet in .env, doorgegeven via compose):
#   SITE_ADDRESS  - het domein/host waarop de site draait
#                   lokaal: jouw-host.local   prod: transcriptie.jouwdomein.nl
#   CADDY_TLS     - TLS-modus:
#                   "internal"                    -> Caddy's lokale CA (browser-waarschuwing,
#                                                    tenzij je die root-CA op de clients vertrouwt)
#                   "jij@jouwdomein.nl"           -> automatische Let's Encrypt-certificaten (prod)
#                   "/certs/cert.pem /certs/key.pem" -> je eigen certificaat (geen waarschuwing als
#                                                    de clients de uitgevende CA vertrouwen)
#
# getUserMedia (microfoon) vereist een secure context: https of localhost. Daarom
# draait alles hier standaard over https.

# Globale opties: default_sni zorgt dat verbindingen ZONDER SNI (bv. toegang via
# een IP-adres, want IP's mogen niet in SNI) toch een certificaat/site krijgen.
{
	default_sni {$DEFAULT_SNI:localhost}
}

{$SITE_ADDRESS:localhost} {
	tls {$CADDY_TLS:internal}
	encode gzip

	# Security-headers (defense-in-depth). Het systeem draait op een geïsoleerd VLAN;
	# dit is de applicatielaag daarbovenop. De frontend is CSP-veilig: geen externe CDN,
	# geen inline scripts (alleen /js/app.js), dus een strak script-src 'self' kan.
	# Let op: microfoon (getUserMedia) en scherm/tab-audio (getDisplayMedia) blijven
	# toegestaan via Permissions-Policy; media-src blob: is nodig voor de opname-preview.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "microphone=(self), display-capture=(self), camera=(), geolocation=(), payment=(), usb=()"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API en SSE naar de FastAPI-service. flush_interval -1 houdt SSE realtime.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Serveer Caddy's interne root-CA (alleen aanwezig bij CADDY_TLS=internal), zodat
	# gebruikers 'm kunnen installeren om de browserwaarschuwing weg te nemen.
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		# Inline (GEEN attachment): iOS/iPadOS toont dan de "profiel installeren"-prompt
		# i.p.v. het cert stilletjes naar Bestanden weg te schrijven. Desktopbrowsers
		# downloaden 'm alsnog op de .crt-extensie in de URL.
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	# Handleiding/quickref (docs/) onder /docs. handle_path strip't het prefix, zodat
	# /docs/handleiding.html -> /srv-docs/handleiding.html en de relatieve screenshots/
	# fonts (/docs/screenshots/*, /docs/fonts/*) ook kloppen.
	handle_path /docs/* {
		root * /srv-docs
		header Cache-Control "no-cache"
		file_server
	}

	# Statische frontend. Cache-Control: no-cache => de browser mag cachen maar moet
	# eerst revalideren (via ETag); ongewijzigd levert een goedkope 304. Voorkomt dat
	# gebruikers na een update op een oude index.html/app.js blijven hangen.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		# Ontbrekende ASSETS (paden met een extensie, bv. .js/.css/.woff2) geven een ECHTE 404 —
		# niet de SPA-fallback naar index.html. Anders wordt een ontbrekend script (zoals de
		# editor-bundle) als text/html geserveerd en loopt de module-import met een MIME-fout stuk.
		@asset path_regexp \.[A-Za-z0-9]+$
		handle @asset {
			try_files {path} =404
			file_server
		}
		# Overige paden (navigatie zonder extensie): SPA-fallback naar index.html.
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	request_body {
		max_size 300MB
	}
}
