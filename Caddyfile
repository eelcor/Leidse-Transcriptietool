# Caddy: serveert de statische frontend en proxyt de API, met HTTPS.
#
# Domein en TLS-modus komen uit env-vars (gezet in .env, doorgegeven via compose):
#   SITE_ADDRESS  - het domein/host waarop de site draait
#                   lokaal: jouw-host.local   prod: transcriptie.jouwdomein.nl
#   CADDY_TLS     - TLS-modus:
#                   "internal"                    -> Caddy's lokale CA (browser-waarschuwing,
#                                                    tenzij je die root-CA op de clients vertrouwt)
#                   "jij@jouwdomein.nl"           -> automatische Let's Encrypt-certificaten (prod)
#                   "/certs/cert.pem /certs/key.pem" -> je eigen certificaat (geen waarschuwing als
#                                                    de clients de uitgevende CA vertrouwen)
#
# getUserMedia (microfoon) vereist een secure context: https of localhost. Daarom
# draait alles hier standaard over https.

# Globale opties: default_sni zorgt dat verbindingen ZONDER SNI (bv. toegang via
# een IP-adres, want IP's mogen niet in SNI) toch een certificaat/site krijgen.
{
	default_sni {$DEFAULT_SNI:localhost}
}

{$SITE_ADDRESS:localhost} {
	tls {$CADDY_TLS:internal}
	encode gzip

	# API en SSE naar de FastAPI-service. flush_interval -1 houdt SSE realtime.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Serveer Caddy's interne root-CA (alleen aanwezig bij CADDY_TLS=internal), zodat
	# gebruikers 'm kunnen installeren om de browserwaarschuwing weg te nemen.
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		# Inline (GEEN attachment): iOS/iPadOS toont dan de "profiel installeren"-prompt
		# i.p.v. het cert stilletjes naar Bestanden weg te schrijven. Desktopbrowsers
		# downloaden 'm alsnog op de .crt-extensie in de URL.
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	# Statische frontend.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 300MB
	}
}
